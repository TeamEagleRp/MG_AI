<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.botName %> - <%= lang === 'ar' ? 'لوحة التحكم' : 'Dashboard' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤖</text></svg>">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <span class="nav-logo">MG AI</span>
                <span class="nav-badge">444</span>
            </div>
            <div class="nav-links">
                <a href="/" class="nav-link"><%= lang === 'ar' ? 'الرئيسية' : 'Home' %></a>
                <div class="user-menu">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}${user.avatar.startsWith('a_') ? '.gif' : '.png'}` : '/img/default-avatar.svg' %>" alt="Avatar" class="user-avatar">
                    <span><%= user.global_name || user.username %></span>
                    <a href="/auth/logout" class="btn btn-sm btn-secondary"><%= lang === 'ar' ? 'تسجيل خروج' : 'Logout' %></a>
                </div>
                <form action="/lang/<%= lang === 'ar' ? 'en' : 'ar' %>" method="POST" class="lang-form">
                    <button type="submit" class="btn btn-lang">
                        <%= lang === 'ar' ? '🇬🇧 English' : '🇸🇦 العربية' %>
                    </button>
                </form>
            </div>
            <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Toggle menu">☰</button>
        </div>
    </nav>

    <!-- Dashboard Content -->
    <section class="dashboard">
        <div class="container">
            <div class="dashboard-header">
                <div class="user-profile">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}${user.avatar.startsWith('a_') ? '.gif' : '.png'}` : '/img/default-avatar.svg' %>" alt="Avatar" class="profile-avatar">
                    <div class="profile-info">
                        <h2><%= user.global_name || user.username %></h2>
                        <span class="profile-tag">@<%= user.username %></span>
                        <span class="profile-id">ID: <%= user.id %></span>
                    </div>
                </div>
            </div>

            <div class="dashboard-content">
                <div class="dashboard-section">
                    <h3><%= lang === 'ar' ? '🌟 السيرفرات التي يمكنك إضافة البوت إليها' : '🌟 Servers you can add the bot to' %></h3>
                    <% if (manageableGuilds.length > 0) { %>
                        <div class="guilds-grid">
                            <% manageableGuilds.forEach(guild => { %>
                                <div class="guild-card">
                                    <div class="guild-icon">
                                        <% if (guild.icon) { %>
                                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="<%= guild.name %>">
                                        <% } else { %>
                                            <div class="guild-icon-placeholder">
                                                <%= guild.name.charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="guild-info">
                                        <h4><%= guild.name %></h4>
                                        <span class="guild-id"><%= guild.id %></span>
                                    </div>
                                    <a href="/add-bot/<%= guild.id %>" class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
                                        <%= lang === 'ar' ? '+ إضافة البوت' : '+ Add Bot' %>
                                    </a>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-icon">🔍</div>
                            <p><%= lang === 'ar' 
                                ? 'لم يتم العثور على سيرفرات تمتلك فيها صلاحية الإدارة. تأكد من أنك تملك صلاحية "Administrator" أو "Manage Server" في أحد السيرفرات.'
                                : 'No servers found where you have admin permissions. Make sure you have "Administrator" or "Manage Server" permission in a server.' 
                            %></p>
                        </div>
                    <% } %>
                </div>

                <div class="dashboard-section">
                    <h3><%= lang === 'ar' ? '📊 جميع سيرفراتك' : '📊 All Your Servers' %></h3>
                    <% if (guilds.length > 0) { %>
                        <div class="guilds-grid">
                            <% guilds.forEach(guild => { %>
                                <div class="guild-card">
                                    <div class="guild-icon">
                                        <% if (guild.icon) { %>
                                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="<%= guild.name %>">
                                        <% } else { %>
                                            <div class="guild-icon-placeholder">
                                                <%= guild.name.charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="guild-info">
                                        <h4><%= guild.name %></h4>
                                        <span class="guild-id"><%= guild.id %></span>
                                    </div>
                                    <span class="guild-owner-badge"><%= guild.owner ? '👑' : '' %></span>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-icon">📭</div>
                            <p><%= lang === 'ar' ? 'ليس لديك أي سيرفرات.' : 'You have no servers.' %></p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="footer-logo">MG AI</span>
                    <span class="footer-badge">444</span>
                    <p><%= lang === 'ar' ? 'بوت ذكاء اصطناعي متكامل' : 'Complete AI Bot' %></p>
                </div>
            </div>
            <div class="footer-bottom">
                <span class="copyright">MG CoDe</span>
                <span class="separator">|</span>
                <span>444</span>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>

